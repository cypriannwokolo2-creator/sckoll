# Sckoll backend env — copy to backend/.env and fill in real secrets.
# backend/.env is gitignored and never committed.
PORT=8110
DATABASE_URL=postgres://sckoll:CHANGE_ME_long_random_string@localhost:5435/sckoll
REDIS_URL=redis://localhost:6381
SITE_URL=https://www.sckoll.com
FRONTEND_URL=https://www.sckoll.com
API_URL=https://api.sckoll.com
AUTH_SECRET=CHANGE_ME_32_bytes_random_hex
# Google Sign-In (ID-token flow). Empty = /v1/auth/google returns 503 disabled.
GOOGLE_CLIENT_ID=
# Client secret from the same OAuth client — server-only (kept in backend/.env
# like the other secrets; never returned, logged, or sent to the frontend).
GOOGLE_CLIENT_SECRET=
# Brevo transactional email. Empty = mail stays off (logged in dev only).
BREVO_API_KEY=
BREVO_FROM_SECURITY=Sckoll <no-reply@sckoll.com>
BREVO_FROM_HELLO=Sckoll <hello@sckoll.com>
# Paystack Collections + Transfers (Collections key + Transfers enabled). Empty = payments 503 fail-closed.
PAYSTACK_SECRET_KEY=
# Inbox for the /v1/contact form. Empty = falls back to BREVO_FROM_HELLO.
CONTACT_TO=
